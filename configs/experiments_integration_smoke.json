{
  "schema_version": 1,
  "scope": "local-container",
  "cluster": null,
  "warmups": 1,
  "repeats": 3,
  "timeout_seconds": 60,
  "launcher": [
    "mpiexec",
    "--bind-to",
    "none",
    "-n",
    "{ranks}"
  ],
  "env": {
    "OMP_DYNAMIC": "FALSE",
    "OMPI_MCA_rmaps_base_oversubscribe": "1"
  },
  "studies": [
    {
      "id": "integration_pipeline",
      "kind": "strong",
      "baseline": "serial",
      "iterations": 10,
      "check_every": 3,
      "cases": [
        {
          "label": "serial",
          "variant": "serial",
          "n": 31,
          "ranks": 1,
          "threads": 1
        },
        {
          "label": "mpi-sendrecv",
          "variant": "mpi",
          "n": 31,
          "ranks": 2,
          "threads": 1,
          "communication": "sendrecv"
        },
        {
          "label": "mpi-overlap",
          "variant": "mpi",
          "n": 31,
          "ranks": 2,
          "threads": 1,
          "communication": "overlap"
        },
        {
          "label": "openmp",
          "variant": "openmp",
          "n": 31,
          "ranks": 1,
          "threads": 2
        },
        {
          "label": "hybrid-sendrecv",
          "variant": "mpi_openmp",
          "n": 31,
          "ranks": 2,
          "threads": 2,
          "communication": "sendrecv"
        },
        {
          "label": "hybrid-overlap",
          "variant": "mpi_openmp",
          "n": 31,
          "ranks": 2,
          "threads": 2,
          "communication": "overlap"
        }
      ]
    }
  ]
}
