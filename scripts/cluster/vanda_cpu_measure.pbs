#!/bin/bash -l
# Matched single-node CPU experiments following successful pilot 1514325.
# Submit from the uploaded source-manifest/helper directory using qsub -P PROJECT.
#PBS -N p3-c-measure
#PBS -q auto
#PBS -l select=1:ncpus=16:mpiprocs=16:ompthreads=1:mem=16gb:node_pool=cpu_node
#PBS -l walltime=00:45:00
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
submission_dir=$PWD
revision=$(python3 -c 'import json;print(json.load(open("project3-source.manifest.json"))["revision"])')
project_root="$PWD/project3-c-source-${revision:0:7}"
pilot="$project_root/results/raw/vanda-pilot-${PROJECT3_PILOT_ID:-1514325.stdct-mgmt-02}"
[ "$(cat "$pilot/exit_code.txt")" = 0 ]
module load CMake/3.26.3-GCCcore-12.3.0 openmpi/gcc/64/4.1.8
cd "$project_root"
evidence="$project_root/results/raw/vanda-measure-${PBS_JOBID}"
mkdir "$evidence"
trap 'rc=$?; printf "%s\n" "$rc" > "$evidence/exit_code.txt"' EXIT
exec > >(tee "$evidence/job.log") 2>&1
cp "$submission_dir/project3-source.manifest.json" "$evidence/source_archive.json"
cp "$submission_dir/prepare_vanda_experiments_v3.py" "$evidence/preparation.py"
cp "$0" "$evidence/submitted_script.pbs"
sha256sum "$evidence/preparation.py" "$evidence/submitted_script.pbs" > "$evidence/job_sources.sha256"
date -u +%Y-%m-%dT%H:%M:%SZ
hostname
lscpu
cat "$PBS_NODEFILE"
cat /proc/self/status | grep -E '^Cpus_allowed_list|^Mems_allowed_list'
module list
sha256sum -c "$pilot/binaries.sha256"
python3 - "$pilot" <<'PY'
from pathlib import Path
import json,sys
root=Path(sys.argv[1])
for comm in ('sendrecv','overlap'):
 result=json.loads((root/('bound-'+comm+'.json')).read_text())
 assert result['threads_per_rank']==2 and result['ranks']==2
 binding=(root/('bound-'+comm+'.stderr')).read_text().lower()
 assert 'bound to' in binding and 'not bound' not in binding and 'failed' not in binding
PY
python3 "$submission_dir/prepare_vanda_experiments_v3.py" --pilot "$pilot" --output "$evidence/experiments.json"
python3 scripts/run_experiments.py --config "$evidence/experiments.json" --bin-dir build-vanda --output "$evidence/collection"
python3 scripts/summarize_results.py --input "$evidence/collection" --output "$evidence/summary"
# Plotting occurs locally after download; target compute nodes need no matplotlib.
date -u +%Y-%m-%dT%H:%M:%SZ
printf 'Measurement complete: %s\n' "$evidence"
