{
  "schema_version": 1,
  "timeout_seconds": 30,
  "comparison": {
    "atol": 1e-10,
    "rtol": 1e-10,
    "boundary_atol": 0.0
  },
  "launch": {
    "prefix": [
      "/usr/bin/mpiexec",
      "-n",
      "3"
    ],
    "extra_args": [
      "--kernel",
      "serial"
    ],
    "expected_ranks": 3,
    "expected_threads": 1,
    "env": {
      "OMP_NUM_THREADS": "1",
      "OMP_DYNAMIC": "FALSE",
      "OMPI_MCA_rmaps_base_oversubscribe": "1",
      "OMPI_MCA_hwloc_base_binding_policy": "none"
    }
  },
  "cases": [
    {
      "name": "initial_state",
      "n": 7,
      "problem": "continuous-sine",
      "mode": "fixed",
      "iterations": 0
    },
    {
      "name": "original_odd",
      "n": 7,
      "problem": "continuous-sine",
      "mode": "fixed",
      "iterations": 5,
      "check_every": 3
    },
    {
      "name": "mixed_k0",
      "n": 7,
      "problem": "discrete-mixed",
      "mode": "fixed",
      "iterations": 0,
      "check_every": 3
    },
    {
      "name": "mixed_k1",
      "n": 7,
      "problem": "discrete-mixed",
      "mode": "fixed",
      "iterations": 1,
      "check_every": 3
    },
    {
      "name": "mixed_k2",
      "n": 7,
      "problem": "discrete-mixed",
      "mode": "fixed",
      "iterations": 2,
      "check_every": 3
    },
    {
      "name": "mixed_k5",
      "n": 7,
      "problem": "discrete-mixed",
      "mode": "fixed",
      "iterations": 5,
      "check_every": 3
    },
    {
      "name": "mixed_k16",
      "n": 7,
      "problem": "discrete-mixed",
      "mode": "fixed",
      "iterations": 16,
      "check_every": 3
    },
    {
      "name": "mixed_smallest",
      "n": 3,
      "problem": "discrete-mixed",
      "mode": "fixed",
      "iterations": 5
    },
    {
      "name": "mixed_converged",
      "n": 15,
      "problem": "discrete-mixed",
      "mode": "converge",
      "iterations": 20000,
      "tol": 1e-11,
      "check_every": 7
    },
    {
      "name": "continuous_converged",
      "n": 15,
      "problem": "continuous-sine",
      "mode": "converge",
      "iterations": 20000,
      "tol": 1e-11,
      "check_every": 5
    },
    {
      "name": "zero_initial_converged",
      "n": 7,
      "problem": "zero",
      "mode": "converge",
      "iterations": 100
    },
    {
      "name": "max_iterations",
      "n": 7,
      "problem": "continuous-sine",
      "mode": "converge",
      "iterations": 1,
      "expected_exit": 2
    }
  ]
}
