  },
  "cases": [
    {
      "n": 31,
      "iterations": 10,
      "check_every": 3,
      "ranks": 2,
      "ranks_per_node": 2,
      "communication": "sendrecv"
    },
    {
      "n": 31,
      "iterations": 10,
      "check_every": 3,
      "ranks": 2,
      "ranks_per_node": 2,
      "communication": "overlap"
    }
  ]
