{
  "schema_version": 1,
  "mpi_exe": "build/poisson_mpi",
  "serial_exe": "build/poisson_serial",
  "launcher": [
    "build-tools/bin/mpiexec",
    "-n",
    "{ranks}"
  ],
  "env": {
    "OMP_NUM_THREADS": "1"
